{
  "name": "@siam/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "etl:production": "tsx src/db/etl/production.ts",
    "backfill:phase9-group0": "tsx src/db/seed/phase9-group0-catalog-backfill.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "postgres": "^3.4.4",
    "puppeteer": "^25.5.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
