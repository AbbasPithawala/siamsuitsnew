# Copy to .env and fill in real values. Never commit .env.

# Postgres connection (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgres://siam:siam_dev_password@localhost:5432/siam_dev

NODE_ENV=development
PORT=4545

# Auth — required. Used to sign/verify login JWTs; the server refuses to boot without it.
JWT_SECRET=replace-with-a-real-secret

# AWS S3 (Phase 2+ — placeholders only). Leave blank to use the local-disk storage
# backend (dev/test/CI default, zero AWS dependency) — see storage.service.ts.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=siamsuits

# File storage (Phase 9). Both optional.
# STORAGE_LOCAL_DIR — disk directory the local-disk storage backend writes under. Default: uploads
# STORAGE_LOCAL_DIR=uploads
# PUBLIC_BASE_URL — if unset, the local-disk backend returns path-only URLs (/uploads/...);
# set this in production to get back fully-qualified URLs instead.
# PUBLIC_BASE_URL=https://api.siamsuits.example.com
